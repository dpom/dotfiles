#!/usr/bin/env bash
set -euo pipefail

# update-ollama
# Pins the ollama NixOS service to the latest ollama/ollama GitHub release.
# Edits the ollama module block in Config.txt (the Org source of truth), then
# re-tangles via ./bin/generate-admin so modules/nixos/ollama.nix stays in sync.
# Stops after updating files: no nixos-rebuild, no home-manager switch, no git.
#
# Release assets (ollama-linux-amd64.tar.zst and -rocm) are large (~1-1.4 GB),
# so the script reads their sha256 from the GitHub API asset `digest` field and
# only falls back to curl | sha256sum if the digest is missing. Both digests
# were verified against the downloaded v0.32.8 assets.
#
# If upstream renames the assets, update the two asset names below.

cd "$(dirname "$(dirname "$(readlink -f "$0")")")"

CONFIG="Config.txt"
BLOCK_OPEN='^#[+]begin_src nix :tangle modules/nixos/ollama.nix$'
BLOCK_CLOSE='^#[+]end_src$'
SED_OPEN="\\|${BLOCK_OPEN}|"
SED_CLOSE="\\|${BLOCK_CLOSE}|"
REPO="ollama/ollama"
CPU_ASSET="ollama-linux-amd64.tar.zst"
ROCM_ASSET="ollama-linux-amd64-rocm.tar.zst"

# --- current pinned version -------------------------------------------------
CURRENT=$(sed -n "${SED_OPEN},${SED_CLOSE}s|^  version = \"\([^\"]*\)\";$|\1|p" "$CONFIG" | head -1)
if [[ -z "$CURRENT" ]]; then
  echo "error: could not read the pinned ollama version from $CONFIG" >&2
  exit 1
fi
echo "Current pinned version: v${CURRENT}"

# --- latest release from GitHub API ----------------------------------------
echo "Fetching latest release from GitHub API..."
RELEASE=$(curl -fsSL --connect-timeout 10 --max-time 60 "https://api.github.com/repos/${REPO}/releases/latest")
TAG=$(echo "$RELEASE" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
if [[ -z "$TAG" ]]; then
  echo "error: could not parse tag_name from GitHub API response" >&2
  exit 1
fi
VERSION=${TAG#v}
if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "error: unexpected release tag '$TAG'; expected vX.Y.Z" >&2
  exit 1
fi
echo "Latest release: $TAG"

# --- idempotence ------------------------------------------------------------
if [[ "$VERSION" == "$CURRENT" ]]; then
  echo "✓ ollama already up to date at v${VERSION}"
  exit 0
fi

# --- asset hashes (API digest, download fallback) ---------------------------
compute_hash () {
  local asset="$1"
  local hex
  hex=$(echo "$RELEASE" | awk -v a="$asset" '
    /"name"[[:space:]]*:/ { block = ($0 ~ a) }
    block && /"digest"[[:space:]]*:/ {
      sub(/.*"digest"[[:space:]]*:[[:space:]]*"/, "")
      sub(/".*/, "")
      print
      exit
    }')
  hex=${hex#sha256:}
  if [[ "$hex" =~ ^[0-9a-f]{64}$ ]]; then
    echo "$hex"
  else
    echo "Asset digest missing for $asset; downloading to compute hash..." >&2
    curl -fsSL --connect-timeout 10 --max-time 1800 \
      "https://github.com/${REPO}/releases/download/${TAG}/${asset}" \
      | sha256sum | cut -d' ' -f1
  fi
}

CPU_HEX=$(compute_hash "$CPU_ASSET")
ROCM_HEX=$(compute_hash "$ROCM_ASSET")
CPU_SRI=$(nix hash convert --to sri "sha256:$CPU_HEX")
ROCM_SRI=$(nix hash convert --to sri "sha256:$ROCM_HEX")
echo "CPU hash:   $CPU_SRI"
echo "ROCm hash:  $ROCM_SRI"

# --- patch Config.txt (block-scoped anchors) --------------------------------
echo "Patching $CONFIG ..."
sed -i "${SED_OPEN},${SED_CLOSE}s|^  version = \"[^\"]*\";$|  version = \"${VERSION}\";|" "$CONFIG"
sed -i "/^    asset = \"${CPU_ASSET}\";\$/ { n; s|^    hash = \".*\";$|    hash = \"${CPU_SRI}\";|; }" "$CONFIG"
sed -i "/${ROCM_ASSET}\"\$/ { n; s|^      hash = \".*\";$|      hash = \"${ROCM_SRI}\";|; }" "$CONFIG"

# verify the patch landed
NEW_VERSION=$(sed -n "${SED_OPEN},${SED_CLOSE}s|^  version = \"\([^\"]*\)\";$|\1|p" "$CONFIG" | head -1)
if [[ "$NEW_VERSION" != "$VERSION" ]] || ! grep -q "\"$CPU_SRI\"" "$CONFIG" || ! grep -q "\"$ROCM_SRI\"" "$CONFIG"; then
  echo "error: failed to patch $CONFIG; manual edit required" >&2
  exit 1
fi

# --- re-tangle ---------------------------------------------------------------
echo "Re-tangling Config.txt via ./bin/generate-admin ..."
./bin/generate-admin

echo "✓ ollama pinned to v${VERSION}"
echo "Review the diff, then apply with: ent update-system (or 'sudo nixos-rebuild switch --flake .#<host>')"
echo "Commit Config.txt, modules/nixos/ollama.nix, and this script together."
