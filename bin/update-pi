#!/usr/bin/env bb
; update-pi
; Pins both pi agent packages (pi-coding-agent and pi-acp) to the latest
; GitHub releases. Edits the pi module block in Config.txt (the Org source of
; truth), then re-tangles via ./bin/generate-admin so modules/home/pi.nix
; stays in sync. Stops after updating files: no home-manager switch, no
; nixos-rebuild, no git.
;
; npmDepsHash (a hash of the npm dependency tree) cannot be derived from the
; source tarball, so the script temporarily sets lib.fakeHash, builds the
; package, parses the real hash from the `got:` error line, and writes it back.
;
; pi-coding-agent model data: upstream v0.84.1+ generates
; packages/ai/src/providers/data/*.json from live APIs at build time
; (npm run generate-models), which breaks the hermetic Nix build. The module
; recipe vendors a hydrated snapshot into modules/home/pi-model-data/<version>/
; (copied into the source in postPatch) and builds with upstream's hermetic
; build:offline path. When the pinned version bumps, this script re-hydrates the
; snapshot with a bare node (>= 22.6, no npm install, no provider keys).

(require '[babashka.curl :as curl]
         '[babashka.process :as p]
         '[cheshire.core :as json]
         '[clojure.string :as str])

(def config-file "Config.txt")
(def block-open #"^#\+begin_src nix :tangle modules/home/pi\.nix$")
(def block-close #"^#\+end_src$")

(def repo-root
  (-> (System/getProperty "babashka.file")
      java.io.File.
      .getCanonicalFile
      .getParentFile
      .getParentFile
      .getPath))

(def host (str/trim (:out (p/sh "hostname"))))

; pname | owner/repo | owner | repo | max buildable version ("" = no cap)
(def pkgs
  [{:pname "pi-acp" :gh "svkozak/pi-acp" :owner "svkozak" :repo "pi-acp" :maxbuildable ""}
   {:pname "pi-coding-agent" :gh "earendil-works/pi" :owner "earendil-works" :repo "pi" :maxbuildable ""}])

(defn die [msg]
  (binding [*out* *err*]
    (println (str "error: " msg)))
  (System/exit 1))

(defn sh-out [& args]
  (let [opts (if (map? (last args)) (last args) {})
        args (if (map? (last args)) (butlast args) args)
        {:keys [out err exit]} (apply p/sh opts args)]
    (when (not= 0 exit)
      (binding [*out* *err*]
        (println (str "error: command failed: " (str/join " " args)))
        (when (seq err) (println err)))
      (System/exit 1))
    (str/trim out)))

(defn block-range [lines]
  (let [i (first (keep-indexed (fn [idx l] (when (re-find block-open l) idx)) lines))
        j (first (keep-indexed (fn [idx l]
                                 (when (and (some? i) (> idx i))
                                   (when (re-find block-close l) idx)))
                               lines))]
    (when (and (some? i) (some? j)) [i j])))

(defn pinned-version [lines pname]
  (let [pname-re (re-pattern (str "^    pname = \"" pname "\";$"))]
    (some (fn [[a b]]
            (when (re-find pname-re a)
              (second (re-find #"^    version = \"([^\"]*)\";$" b))))
          (partition 2 1 lines))))

(defn version-parts [s]
  (mapv #(Long/parseLong %) (re-seq #"\d+" s)))

(defn version->? [a b]
  (pos? (compare (version-parts a) (version-parts b))))

(defn latest-tag [gh]
  (let [res (curl/get (str "https://api.github.com/repos/" gh "/releases/latest")
                      {:throw false :connect-timeout 10 :timeout 60000})]
    (when (= 200 (:status res))
      (get-in (json/parse-string (:body res) true) [:tag_name]))))

(defn fetch-src [owner repo tag]
  (let [url (str "https://github.com/" owner "/" repo "/archive/refs/tags/" tag ".tar.gz")
        {:keys [out err exit]} (p/sh {:dir repo-root} "nix-prefetch-url" "--unpack" url)]
    (when (not= 0 exit)
      (die (str "nix-prefetch-url failed for " url)))
    (let [combined (str out "\n" err)
          raw (->> (str/split-lines combined)
                   (remove str/blank?)
                   (filter #(re-matches #"[a-z0-9]{52}" %))
                   last)
          store-path (second (re-find #"path is '([^']+)'" combined))]
      (when (nil? raw) (die (str "could not parse hash from nix-prefetch-url for " url)))
      (when (nil? store-path) (die (str "could not parse store path from nix-prefetch-url for " url)))
      {:sri (sh-out "nix" "hash" "convert" "--to" "sri" (str "sha256:" raw))
       :store-path store-path})))

(defn node-supports-strip-types? []
  (let [v (str/replace (sh-out "node" "--version") #"^v" "")
        [major minor] (mapv #(Long/parseLong %) (take 2 (str/split v #"\.")))]
    (or (>= major 23)
        (and (= major 22) (>= minor 6)))))

(defn hydrate-model-data [{:keys [version store-path]}]
  (let [tmp (str (System/getProperty "java.io.tmpdir") "/pi-hydrate-" version)
        script "packages/ai/scripts/generate-models.ts"
        data-dir (str repo-root "/modules/home/pi-model-data")]
    (sh-out "rm" "-rf" tmp)
    (sh-out "mkdir" "-p" tmp)
    (sh-out "cp" "-r" (str store-path "/.") tmp)
    (let [{:keys [exit err]} (p/sh {:dir tmp} "node" script "--strict" "--data-only")]
      (when (not= 0 exit)
        (die (str "model data hydration failed for v" version ": " (or err ""))))
      (let [gen-dir (java.io.File. (str tmp "/packages/ai/src/providers/data"))
            files (when (.isDirectory gen-dir) (.listFiles gen-dir))]
        (when (or (nil? files)
                  (not (some #(= ".manifest.json" (.getName %)) files))
                  (not (some (fn [f] (and (str/ends-with? (.getName f) ".json")
                                          (not= ".manifest.json" (.getName f))))
                             files)))
          (die (str "hydration produced no model data in " (.getPath gen-dir))))))
    (sh-out "rm" "-rf" (str data-dir "/" version))
    (sh-out "mkdir" "-p" (str data-dir "/" version))
    (sh-out "cp" "-r" (str tmp "/packages/ai/src/providers/data/.") (str data-dir "/" version))
    (sh-out "rm" "-rf" tmp)
    (println (str "  model data vendored to modules/home/pi-model-data/" version "/"))))

(defn prune-model-data-dirs [keep-version]
  (let [dir (java.io.File. (str repo-root "/modules/home/pi-model-data"))]
    (when (.isDirectory dir)
      (doseq [f (.listFiles dir)]
        (when (and (.isDirectory f)
                   (not= (.getName f) keep-version))
          (sh-out "rm" "-rf" (.getPath f))
          (println (str "  removed stale model data dir: " (.getName f))))))))

(defn patch-version [lines pname version]
  (let [pname-re (re-pattern (str "^    pname = \"" pname "\";$"))]
    (vec (map-indexed
          (fn [idx line]
            (if (and (pos? idx)
                     (re-find pname-re (nth lines (dec idx)))
                     (re-find #"^    version = \"[^\"]*\";$" line))
              (str/replace line #"^    version = \"[^\"]*\";$"
                           (str "    version = \"" version "\";"))
              line))
          lines))))

(defn patch-src-hash [lines owner sri]
  (let [owner-re (re-pattern (str "^      owner = \"" owner "\";$"))]
    (loop [acc [] seen? false [line & more] lines]
      (cond
        (nil? line) (vec acc)
        (and seen? (re-find #"^      hash = \"[^\"]*\";$" line))
        (recur (conj acc (str/replace line #"^      hash = \"[^\"]*\";$"
                                      (str "      hash = \"" sri "\";")))
               false more)
        (re-find owner-re line)
        (recur (conj acc line) true more)
        :else (recur (conj acc line) seen? more)))))

(defn patch-npmdeps [lines sri replacement]
  (let [sri-re (re-pattern (str "^      hash = \"" sri "\";$"))]
    (loop [acc [] seen? false [line & more] lines]
      (cond
        (nil? line) (vec acc)
        (and seen? (re-find #"^    npmDepsHash = .*;$" line))
        (recur (conj acc (str/replace line #"^    npmDepsHash = .*;$"
                                      (str "    npmDepsHash = " replacement ";")))
               false more)
        (re-find sri-re line)
        (recur (conj acc line) true more)
        :else (recur (conj acc line) seen? more)))))

(defn tangle []
  (sh-out "bash" "./bin/generate-admin" {:dir repo-root}))

(defn read-config []
  (str/split-lines (slurp config-file)))

(defn write-config [lines]
  (let [text (str/join "\n" lines)
        original (slurp config-file)
        text (if (and (str/ends-with? original "\n")
                      (not (str/ends-with? text "\n")))
               (str text "\n")
               text)]
    (spit config-file text)))

; --- resolve latest releases and caps ---------------------------------------
(def infos
  (mapv
   (fn [{:keys [pname gh maxbuildable] :as spec}]
     (let [tag (latest-tag gh)
           _ (when (nil? tag) (die (str "could not resolve latest release for " gh)))
           version (str/replace tag #"^v" "")
           _ (when-not (re-matches #"[0-9]+\.[0-9]+\.[0-9]+" version)
               (die (str "unexpected release tag '" tag "' for " gh "; expected vX.Y.Z")))
           current (pinned-version (read-config) pname)
           capped? (and (seq maxbuildable) (version->? version maxbuildable))
           final-version (if capped? current version)]
       (when capped?
         (println (str "⚠  " pname ": latest " tag " exceeds the max buildable version v" maxbuildable
                       " (upstream generates provider data from live APIs at build time, breaking the hermetic Nix build). Keeping v" current "; update the module recipe to lift this cap.")))
       (when-not capped?
         (println (str pname ": current v" current ", latest " tag)))
       (assoc spec :tag tag :version version :current current :capped? capped?
              :final-version final-version)))
   pkgs))

; --- idempotence: all already at latest -> nothing to do --------------------
(when (every? (fn [{:keys [current final-version]}] (= current final-version)) infos)
  (let [pi-acp (first infos)
        agent (second infos)]
    (println (str "✓ pi already up to date (pi-acp " (:final-version pi-acp)
                  ", pi-coding-agent " (:final-version agent) ")")))
  (System/exit 0))

; --- source tarball hashes ---------------------------------------------------
(def src-info
  (into {}
        (map (fn [{:keys [pname owner repo tag current final-version]}]
               (if (= current final-version)
                 [pname nil]
                 (do
                   (println (str "Prefetching source tarball for " pname " ..."))
                   (let [info (fetch-src owner repo tag)]
                     (println (str "  src hash: " (:sri info)))
                     [pname info]))))
             infos)))

; --- patch Config.txt: version + src hash ------------------------------------
(println (str "Patching " config-file " ..."))
(write-config
 (reduce (fn [lines {:keys [pname owner current final-version]}]
           (if (= current final-version)
             lines
             (-> lines
                 (patch-version pname final-version)
                 (patch-src-hash owner (:sri (src-info pname))))))
         (read-config)
         infos))

(tangle)

; --- hydrate model data for a bumped pi-coding-agent version -----------------
(doseq [{:keys [pname current final-version]} infos]
  (when (and (= pname "pi-coding-agent") (not= current final-version))
    (println (str "Hydrating model data for pi-coding-agent v" final-version " ..."))
    (when-not (node-supports-strip-types?)
      (die "model data hydration requires node >= 22.6 (direct .ts execution); update your node."))
    (hydrate-model-data (assoc (src-info pname) :version final-version))
    (prune-model-data-dirs final-version)))

; --- npmDepsHash discovery (fake-hash build) --------------------------------
(doseq [{:keys [pname tag current final-version]} infos]
  (when-not (= current final-version)
    (println (str "Discovering npmDepsHash for " pname " (" tag ") ..."))
    (let [sri (:sri (src-info pname))]
      (write-config (patch-npmdeps (read-config) sri "lib.fakeHash"))
      (tangle)
      (let [expr (str "let c = (builtins.getFlake \"" repo-root
                      "\").homeConfigurations.\"dan@" host
                      "\".config; in builtins.filter (p: (p.pname or \"\") == \"" pname
                      "\") c.home.packages")
            out (p/sh {:dir repo-root} "nix" "build" "--impure" "--no-link" "--expr" expr)
            combined (str (:out out) "\n" (:err out))
            got (second (re-find #"got:\s*(sha256-[A-Za-z0-9+/=]+)" combined))]
        (when (nil? got)
          (binding [*out* *err*]
            (println (str "error: could not parse npmDepsHash from build output for " pname))
            (println (str/join "\n" (take-last 20 (str/split-lines combined))))
            (println (str "Set npmDepsHash manually in " config-file " under " pname ".")))
          (System/exit 1))
        (println (str "  npmDepsHash: " got))
        (write-config (patch-npmdeps (read-config) sri (str "\"" got "\"")))))))

; --- final tangle + verify ----------------------------------------------------
(tangle)

(doseq [{:keys [pname current final-version]} infos]
  (when-not (= current final-version)
    (let [newver (pinned-version (read-config) pname)
          sri (:sri (src-info pname))]
      (when (or (not= newver final-version)
                (not (str/includes? (slurp config-file) (str "\"" sri "\""))))
        (die (str "failed to patch " config-file " for " pname "; manual edit required"))))))
(when (str/includes? (slurp config-file) "npmDepsHash = lib.fakeHash;")
  (die (str "a lib.fakeHash npmDepsHash was left behind in " config-file "; manual edit required")))

(let [pi-acp (first infos)
      agent (second infos)]
  (println (str "✓ pi pinned to pi-acp " (:final-version pi-acp)
                ", pi-coding-agent " (:final-version agent))))
(println (str "Review the diff, then apply with: ent update-home (or 'home-manager switch --flake .#dan@" host "')"))
(println "Commit Config.txt, modules/home/pi.nix, modules/home/pi-model-data/, and this script together.")
